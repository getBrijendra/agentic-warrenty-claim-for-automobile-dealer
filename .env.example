# databases (PGlite today, Postgres later — only these URLs change)
DATABASE_URL_CORE=postgresql://postgres@127.0.0.1:5432/postgres
DATABASE_URL_DMS=postgresql://postgres@127.0.0.1:5433/postgres
DATABASE_URL_SIM=postgresql://postgres@127.0.0.1:5434/postgres
DB_POOL_SIZE=8

# adapters (swap by config, not by code)
DMS_ADAPTER=autoline_fake
LLM_PROVIDER=fake                 # fake | anthropic (stub) | openai (stub)
OEM_CONNECTOR_DEFAULT=sim
BLOB_STORE=local
QUEUE=pg
EVENT_BUS=pg_outbox

# agents
WARRANTY_AGENT_MODEL=claude-sonnet-5-5
WARRANTY_FAST_MODEL=claude-haiku-5-5
WARRANTY_MAX_PARALLEL=4
WARRANTY_SIM_SPEED=8640           # 1 real second = 2.4 sim hours (1 sim day = 10 s). CLAUDE.md suggests 1440; tune for pacing
WARRANTY_MODE=live                # live | replay (also toggled in the control room)
WARRANTY_SEED=42
LLM_MAX_TOKENS_PER_CLAIM=150000
LLM_MAX_TOKENS_PER_BATCH=3000000
ESCALATION_AMOUNT_AED=25000

# tenant
BRAND_DISPLAY_NAME=Demo Motors Group
SERVICE_TOKEN_SECRET=dev-only-service-secret

# fake credentials (exercise the auth paths — never real)
OEM_FORD_CLIENT_ID=fake-ford-client
OEM_FORD_CLIENT_SECRET=fake-ford-secret
OEM_JLR_API_KEY=fake-jlr-key
OEM_FERRARI_API_KEY=fake-ferrari-key
OEM_MASERATI_API_KEY=fake-maserati-key
OEM_VINFAST_API_KEY=fake-vinfast-key
OEM_FORD_TRUCKS_API_KEY=fake-fordtrucks-key
AUTOLINE_API_KEY=fake-autoline-key
ANTHROPIC_API_KEY=                # empty → real provider refuses to start
